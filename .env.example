# Runtime: Supabase transaction pooler (port 6543). URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations: Supabase session pooler (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"


# Signs access tokens (HS256). At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=""

PORT=3000
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"


# Email delivery: "resend" or "log" (prints emails to the server log; development only)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
# Sending domain verified in Resend; mail comes from TrustedHands <no-reply@EMAIL_DOMAIN>
EMAIL_DOMAIN=""
# Optional: override the sender entirely
# EMAIL_FROM="TrustedHands <hello@example.com>"

# Phone codes: "africastalking" or "log" (prints to the server log; development only)
SMS_PROVIDER="africastalking"
AFRICAS_TALKING_API_KEY=""
# "sandbox" uses Africa's Talking's sandbox; otherwise your live app username
AFRICAS_TALKING_USERNAME=""
# Registered alphanumeric sender ID (optional)
AFRICAS_TALKING_SENDER_ID=""

# MTN MoMo — Collections (incoming payments)
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MOMO_TARGET_ENVIRONMENT="sandbox"
# The sandbox only accepts EUR; use RWF in production
MOMO_COLLECTION_CURRENCY="EUR"
# Collections subscription key (primary, plus secondary for rotation)
MOMO_PRY_KEY=""
MOMO_SEC_KEY=""
MOMO_API_USER_ID=""
MOMO_API_KEY=""
# Leave blank locally (MTN can't reach localhost); the app polls instead.
# In production: https://<api-host>/v1/webhooks/momo — its host must match the API user's callback host.
MOMO_CALLBACK_URL=""

# MTN MoMo — Disbursements (payouts; not used yet)
MOMO_DSB_PRY_KEY=""
MOMO_DSB_SEC_KEY=""
MOMO_DISBURSEMENT_CURRENCY="EUR"
MOMO_DSB_CALLBACK_URL=""
