# Runtime: Supabase transaction pooler (port 6543). URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations: Supabase session pooler (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"


# Signs access tokens (HS256). At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=""

PORT=3000
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# MTN MoMo Collections API. Sandbox only accepts EUR; production Rwanda uses RWF.
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MOMO_TARGET_ENVIRONMENT="sandbox"
MOMO_CURRENCY="EUR"
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""
MOMO_CALLBACK_URL=""

# Email delivery: "resend" or "log" (prints emails to the server log; development only)
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
# Sending domain verified in Resend; mail comes from TrustedHands <no-reply@EMAIL_DOMAIN>
EMAIL_DOMAIN=""
# Optional: override the sender entirely
# EMAIL_FROM="TrustedHands <hello@example.com>"

# Phone codes: only "log" for now (development only) until an SMS provider is chosen
SMS_PROVIDER="log"
