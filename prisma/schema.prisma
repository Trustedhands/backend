// TrustedHands domain schema.
//
// Tables live in the `app` schema rather than `public` so Supabase's Data API
// (PostgREST, reachable with the public anon key) cannot see them. All access
// goes through the NestJS API, which also owns authentication (`users`,
// `refresh_tokens`, `verification_codes`). `Profile.id` is the same UUID as
// `User.id`.
//
// Money is stored as whole Rwandan francs (RWF has no minor unit in practice).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT
  ADMIN

  @@schema("app")
}

enum AccountType {
  INDIVIDUAL
  COMPANY

  @@schema("app")
}

enum Gender {
  FEMALE
  MALE
  UNDISCLOSED

  @@schema("app")
}

enum Language {
  EN
  FR
  RW
  SW

  @@schema("app")
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED

  @@schema("app")
}

enum IdDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVING_LICENCE

  @@schema("app")
}

/// Login credentials and contact verification. Profile holds everything else.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Stored lower-cased
  email           String    @unique
  /// scrypt$N$r$p$salt$hash
  passwordHash    String
  /// E.164, e.g. +250781234567
  phone           String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile           Profile?
  refreshTokens     RefreshToken[]
  verificationCodes VerificationCode[]

  @@index([phone])
  @@map("users")
  @@schema("app")
}

/// Opaque, rotating refresh tokens. Each login starts a family; reusing a
/// rotated token revokes the whole family (likely theft).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  /// SHA-256 of the token; the token itself is never stored
  tokenHash String    @unique
  expiresAt DateTime
  /// Set when rotated (exchanged for a new token)
  usedAt    DateTime?
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
  @@schema("app")
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET

  @@schema("app")
}

/// One-time 6-digit codes, stored hashed.
model VerificationCode {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  purpose    VerificationPurpose
  /// The email or phone the code was sent to
  target     String
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("verification_codes")
  @@schema("app")
}

model Profile {
  /// Same UUID as User.id
  id                 String      @id @db.Uuid
  role               UserRole    @default(CLIENT)
  accountType        AccountType @default(INDIVIDUAL)
  fullName           String
  companyName        String?
  avatarPath         String?
  gender             Gender?
  birthDay           Int?        @db.SmallInt
  birthMonth         Int?        @db.SmallInt
  nationality        String?
  countryOfResidence String?
  occupation         String?
  preferredLanguages Language[]
  kycStatus          KycStatus   @default(NOT_STARTED)
  pushEnabled        Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user            User                 @relation(fields: [id], references: [id], onDelete: Cascade)
  addresses       Address[]
  kycSubmissions  KycSubmission[]
  paymentMethods  SavedPaymentMethod[]
  serviceRequests ServiceRequest[]
  payments        Payment[]
  walletEntries   WalletEntry[]
  reviews         Review[]
  tickets         SupportTicket[]

  @@map("profiles")
  @@schema("app")
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  label     String   @default("Home")
  district  String
  sector    String
  street    String
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("addresses")
  @@schema("app")
}

model KycSubmission {
  id              String         @id @default(uuid()) @db.Uuid
  profileId       String         @db.Uuid
  documentType    IdDocumentType
  /// Supabase Storage object paths (private bucket)
  frontPath       String
  backPath        String?
  status          KycStatus      @default(PENDING)
  rejectionReason String?
  reviewedById    String?        @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([status])
  @@map("kyc_submissions")
  @@schema("app")
}

model SavedPaymentMethod {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @db.Uuid
  /// MSISDN without "+", e.g. 250781234567
  msisdn    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, msisdn])
  @@map("saved_payment_methods")
  @@schema("app")
}

// ─── Workers (managed by admins; there is no worker app) ────────────────────

enum ServiceCategory {
  CLEANING
  COOKING
  ERRANDS
  REPAIRS
  LAUNDRY
  DRIVER
  OTHER

  @@schema("app")
}

model Worker {
  id         String            @id @default(uuid()) @db.Uuid
  fullName   String
  phone      String
  gender     Gender
  languages  Language[]
  categories ServiceCategory[]
  photoPath  String?
  idVerified Boolean           @default(false)
  active     Boolean           @default(true)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  assignments ServiceRequest[]
  reviews     Review[]

  @@map("workers")
  @@schema("app")
}

// ─── Service requests ───────────────────────────────────────────────────────

enum ServiceRequestStatus {
  /// Submitted; ops team is matching and pricing
  REQUESTED
  /// Price sent to client, awaiting acceptance and payment
  PRICED
  /// Client asked ops to revise the price or details
  ADJUSTMENT_REQUESTED
  PAID
  /// Worker assigned and confirmed
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("app")
}

enum GenderPreference {
  ANY
  FEMALE
  MALE

  @@schema("app")
}

model ServiceRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  /// Human-readable sequence, shown as SR-<number>
  number             Int              @unique @default(autoincrement())
  clientId           String           @db.Uuid
  category           ServiceCategory
  description        String
  scheduledAt        DateTime
  durationHours      Decimal          @db.Decimal(4, 1)
  preferredGender    GenderPreference @default(ANY)
  preferredLanguages Language[]

  // Address snapshot, so later edits to the client's address don't rewrite history
  addressDistrict  String
  addressSector    String
  addressStreet    String
  addressLatitude  Float?
  addressLongitude Float?

  status             ServiceRequestStatus @default(REQUESTED)
  workerFeeRwf       Int?
  serviceFeeRwf      Int?
  discountRwf        Int                  @default(0)
  quoteNote          String?
  pricedAt           DateTime?
  adjustmentNote     String?
  voucherId          String?              @db.Uuid
  assignedWorkerId   String?              @db.Uuid
  cancellationReason String?
  completedAt        DateTime?
  /// Optimistic concurrency token, bumped on every update
  version            Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  client         Profile               @relation(fields: [clientId], references: [id])
  assignedWorker Worker?               @relation(fields: [assignedWorkerId], references: [id])
  voucher        Voucher?              @relation(fields: [voucherId], references: [id])
  events         ServiceRequestEvent[]
  payments       Payment[]
  review         Review?
  tickets        SupportTicket[]

  @@index([clientId, status])
  @@index([status, scheduledAt])
  @@map("service_requests")
  @@schema("app")
}

model ServiceRequestEvent {
  id               String               @id @default(uuid()) @db.Uuid
  serviceRequestId String               @db.Uuid
  status           ServiceRequestStatus
  /// Profile id of whoever caused the change; null for the system (e.g. payment callback)
  actorId          String?              @db.Uuid
  note             String?
  createdAt        DateTime             @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId, createdAt])
  @@map("service_request_events")
  @@schema("app")
}

// ─── Payments ───────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED

  @@schema("app")
}

enum PaymentProvider {
  MTN_MOMO
  WALLET

  @@schema("app")
}

model Payment {
  id                    String          @id @default(uuid()) @db.Uuid
  /// Receipt sequence, shown as RC-<number>
  receiptNumber         Int             @unique @default(autoincrement())
  serviceRequestId      String          @db.Uuid
  clientId              String          @db.Uuid
  provider              PaymentProvider @default(MTN_MOMO)
  amountRwf             Int
  status                PaymentStatus   @default(PENDING)
  msisdn                String?
  /// X-Reference-Id sent to MoMo requesttopay
  providerReference     String?         @unique @db.Uuid
  providerTransactionId String?
  failureReason         String?
  completedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  client         Profile        @relation(fields: [clientId], references: [id])
  refunds        Refund[]

  @@index([clientId, createdAt])
  @@index([serviceRequestId])
  @@map("payments")
  @@schema("app")
}

/// Refunds are credited to the client's wallet.
model Refund {
  id         String   @id @default(uuid()) @db.Uuid
  paymentId  String   @db.Uuid
  amountRwf  Int
  reason     String
  issuedById String   @db.Uuid
  createdAt  DateTime @default(now())

  payment     Payment      @relation(fields: [paymentId], references: [id])
  walletEntry WalletEntry?

  @@index([paymentId])
  @@map("refunds")
  @@schema("app")
}

enum WalletEntryType {
  REFUND_CREDIT
  PAYMENT_DEBIT
  ADJUSTMENT

  @@schema("app")
}

/// Append-only ledger; a client's balance is the sum of their amountRwf.
model WalletEntry {
  id        String          @id @default(uuid()) @db.Uuid
  profileId String          @db.Uuid
  type      WalletEntryType
  /// Positive for credits, negative for debits
  amountRwf Int
  refundId  String?         @unique @db.Uuid
  note      String?
  createdAt DateTime        @default(now())

  profile Profile @relation(fields: [profileId], references: [id])
  refund  Refund? @relation(fields: [refundId], references: [id])

  @@index([profileId, createdAt])
  @@map("wallet_entries")
  @@schema("app")
}

model Voucher {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  discountRwf    Int
  maxRedemptions Int?
  redemptions    Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  serviceRequests ServiceRequest[]

  @@map("vouchers")
  @@schema("app")
}

// ─── Reviews & support ──────────────────────────────────────────────────────

enum ReviewTag {
  ON_TIME
  THOROUGH
  FRIENDLY
  RESPECTFUL
  COMMUNICATED_WELL

  @@schema("app")
}

model Review {
  id               String      @id @default(uuid()) @db.Uuid
  serviceRequestId String      @unique @db.Uuid
  clientId         String      @db.Uuid
  workerId         String      @db.Uuid
  rating           Int         @db.SmallInt
  /// "What stood out?"
  tags             ReviewTag[]
  /// Shared with the worker by the ops team
  comment          String?
  createdAt        DateTime    @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  client         Profile        @relation(fields: [clientId], references: [id])
  worker         Worker         @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@map("reviews")
  @@schema("app")
}

enum TicketStatus {
  /// Received, not yet picked up
  OPEN
  /// Ops is working on it
  ACTIVE
  CLOSED

  @@schema("app")
}

model SupportTicket {
  id               String       @id @default(uuid()) @db.Uuid
  /// Shown as TK-<number>
  number           Int          @unique @default(autoincrement())
  clientId         String       @db.Uuid
  serviceRequestId String?      @db.Uuid
  /// Derived from the description at creation; ops can rename it
  subject          String
  description      String
  status           TicketStatus @default(OPEN)
  closedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  client         Profile            @relation(fields: [clientId], references: [id])
  serviceRequest ServiceRequest?    @relation(fields: [serviceRequestId], references: [id])
  attachments    TicketAttachment[]

  @@index([clientId, createdAt])
  @@index([status])
  @@map("support_tickets")
  @@schema("app")
}

/// Photos/documents attached to a ticket. Stored in Postgres for the MVP
/// (small, capped files); see AttachmentStore to move them to object storage.
model TicketAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  filename    String
  contentType String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
  @@schema("app")
}
